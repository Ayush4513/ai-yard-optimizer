# Lightweight Dockerfile for Render free tier (no PyTorch — saves ~2GB RAM)
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y gcc g++ curl && rm -rf /var/lib/apt/lists/*

# Install only what's needed (skip PyTorch, sentence-transformers)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        "fastapi==0.104.1" \
        "uvicorn[standard]==0.24.0" \
        "pydantic>=2.0.0,<3.0.0" \
        "python-dotenv==1.0.0" \
        "chromadb==0.4.18" \
        "langchain==0.1.0" \
        "langchain-community==0.0.10" \
        "langchain-anthropic==0.1.0" \
        "langchain-google-genai>=1.0.0" \
        "langchain-core==0.1.10" \
        "anthropic==0.18.1" \
        "python-multipart==0.0.6" \
        "httpx==0.25.2" \
        "SQLAlchemy>=2.0.0"

# Copy application code
COPY .env* ./
COPY Yard-Optimization/backend /app/Yard-Optimization/backend
COPY src /app/src
RUN rm -f /app/src/main.py 2>/dev/null || true
COPY data /app/data
COPY scripts /app/scripts

RUN mkdir -p /app/data /app/chroma_db

WORKDIR /app/Yard-Optimization/backend
ENV PYTHONPATH=/app/Yard-Optimization/backend

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "Modules.main:app", "--host", "0.0.0.0", "--port", "8000"]
